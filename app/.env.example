# Copiar a app/.env solo si no existe. No versionar credenciales reales.
# Node >=22.12; recomendado Node 24 LTS.

# PUBLICAS: Vite incorpora VITE_* al JavaScript del navegador durante el build.
# Nunca poner secretos aqui ni en variables del repositorio para GitHub Pages.

# Origen externo de API, sin ruta, query, hash ni /api/trpc.
# Vacio: mismo origen en desarrollo/Node. Pages/preview sin API no confirma envio.
VITE_API_BASE_URL=

# Correo publico de contacto, solo si hay una direccion real autorizada.
# No configura CONTACT_TO_EMAIL. Vacio por defecto, sin destinatario inventado.
VITE_CONTACT_EMAIL=

# URL publica final del sitio, sin hash. Vacia hasta conocer el destino real.
VITE_SITE_URL=

# Base de assets. Local o dominio personalizado: /.
# El workflow calcula /ITER_V.02/ para este Pages de proyecto si no hay override.
VITE_BASE_PATH=/

# SOLO SERVIDOR/API: nunca enviar estas variables al build estatico ni al browser.
# Landing/contacto no requiere DATABASE_URL ni credenciales de otros servicios.
# Resend requiere cuenta propia y dominio remitente verificado.
# Con credenciales vacias, el formulario debe informar que no se ha enviado.
CONTACT_PROVIDER=resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Origenes exactos separados por comas; sin rutas, comodines ni barra final.
# Desarrollo mismo origen: puede quedar vacio.
# API externa para este Pages: https://juannorenia.github.io (sin /ITER_V.02/).
ALLOWED_ORIGINS=

# Activar solo tras un proxy confiable que sanee las cabeceras reenviadas.
TRUST_PROXY=false
PORT=3000
