# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Contacto ITER (opcional) ─────────────────────────────────────
# El formulario siempre almacena el lead en la base de datos (esa es la
# confirmación real de recepción). Además, puedes reenviarlo a un proveedor:
#
# Opción A — webhook genérico (Zapier, Make, Formspree, etc.):
# CONTACT_FORWARD_URL=       # URL que recibe el lead como JSON (POST)
#
# Opción B — correo vía Resend:
# RESEND_API_KEY=            # API key de Resend
# CONTACT_TO=                # correo destino de las consultas
# CONTACT_FROM=              # remitente verificado en Resend
